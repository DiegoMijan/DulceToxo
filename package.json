{
  "name": "dulce-toxo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:vue-templates": "eslint \"**/*.vue\" --fix --rule 'vue/html-indent: error' --rule 'vue/html-quotes: error' --rule 'vue/html-self-closing: error' --rule 'vue/max-attributes-per-line: error'",
    "format:all": "npm run format && npm run format:vue-templates"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@formkit/auto-animate": "^0.9.0",
    "@nuxt/fonts": "^0.13.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@pinia/nuxt": "^0.11.3",
    "@primeuix/themes": "^2.0.3",
    "@primevue/forms": "^4.5.4",
    "@primevue/nuxt-module": "^4.5.4",
    "@vueuse/core": "^14.2.0",
    "@vueuse/nuxt": "^14.2.0",
    "better-auth": "^1.4.18",
    "blendy": "^0.0.1",
    "magic-regexp": "^0.10.0",
    "mdn-data": "^2.27.0",
    "pinia": "^3.0.4",
