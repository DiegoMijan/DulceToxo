{
  "name": "dulce-toxo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:vue-templates": "eslint \"**/*.vue\" --fix --rule 'vue/html-indent: error' --rule 'vue/html-quotes: error' --rule 'vue/html-self-closing: error' --rule 'vue/max-attributes-per-line: error'",
    "format:all": "npm run format && npm run format:vue-templates",
    "api:types": "dotenv -- bash -c 'openapi-typescript $BACKEND_URL/_openapi.json -o shared/types/api.d.ts'"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.1",
    "@nuxt/image": "^2.2.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@primeuix/themes": "^3.1.0",
    "@primevue/forms": "^5.0.4",
    "@primevue/nuxt-module": "^5.0.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "async": "^3.2.6",
    "better-auth": "^1.7.13",
    "blendy": "^0.0.1",
    "jspdf": "^4.2.1",
    "magic-regexp": "^0.11.2",
    "mdn-data": "^2.37.2",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "postcss-calc": "^11.2.3",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.4",
    "resolve": "^1.22.13",
    "valibot": "^1.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "comentario": "Para que funcione NuxtImage hay que hacer esto tanto en bun como en pnpm",
  "bun": {
    "onlyBuiltDependencies": [
      "sharp",
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-typed-rocks": "^1.0.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nuxt": "^4.6.2",
    "openapi-typescript": "^7.13.0",
    "sass-embedded": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "@typescript-eslint/type-utils": "^8.72.0",
    "@typescript-eslint/scope-manager": "^8.72.0",
    "@typescript-eslint/types": "^8.72.0",
    "@typescript-eslint/typescript-estree": "^8.72.0",
    "@typescript-eslint/visitor-keys": "^8.72.0",
    "@typescript-eslint/project-service": "^8.72.0",
    "@typescript-eslint/tsconfig-utils": "^8.72.0"
  },
  "trustedDependencies": [
    "core-js"
