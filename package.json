      "@parcel/watcher",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@nuxt/eslint": "^1.14.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.1",
    "eslint": "10.0.0",
    "eslint-plugin-typed-rocks": "^1.0.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "nuxt": "^4.3.0",
